// Fineko CRM — модель даних. Джерело істини: ТЗ §4 (D:\...\СРМ\ТЗ-власна-СРМ.md).
// Мультитенантність з дня 1: усі бізнес-сутності мають tenantId + індекс.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// §4.1 Tenant — окремий магазин-клієнт СРМ
// ─────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique @default(uuid()) // Bearer для воронки/MCP/Flows-автоматизацій цього tenant
  ssoOrgId  String? // звʼязок з обліковим записом у SSO-панелі FINEKO
  novaPoshtaApiKey String? // §9.17 — ключ для крон-Flows, що опитує статуси ТТН
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       Category[]
  suppliers        Supplier[]
  products         Product[]
  buyers           Buyer[]
  pipelines        Pipeline[]
  orders           Order[]
  ads              Ad[]
  productExpenses  ProductExpense[]
  returns          Return[]
  payments         Payment[]
}

// ─────────────────────────────────────────────────────────────
// §4.5 Category
// ─────────────────────────────────────────────────────────────
model Category {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  aiInstructions String? // що бот має дізнатись у клієнта для товарів цієї категорії
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.4 Supplier
// ─────────────────────────────────────────────────────────────
model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  mechanism   String? // ручне / EasyDrop / BrewDrop / інше
  contactInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.2 Product
// ─────────────────────────────────────────────────────────────
model Product {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  sku                 String
  price               Decimal  @db.Decimal(12, 2)
  minPrice            Decimal? @db.Decimal(12, 2)
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  presentationText    String? // "Презентація для клієнта" — готовий текст, бот показує verbatim
  adMatchTokens       String[] @default([]) // токени для матчингу за рекламою/артикулом
  companionProductIds String[] @default([]) // допродажі — багато-вибір товарів
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  supplierArticle     String?
  sizeChartImage      String? // шлях/URL до завантаженого файлу
  // ДОПОВНЕННЯ до §4.2 — виявлено при міграції з KeyCRM, у ТЗ не описані, але дані реальні:
  thumbnailUrl        String? // мініатюра для списку товарів (§9.2 "фото (мініатюра thumbnailUrl)" — поле згадане в UI-специфікації, але не було в моделі)
  images              String[] @default([]) // загальні фото товару (KeyCRM attachments_data), не привʼязані до конкретного offer-кольору
  aiNotes             String? // "Додаткова інформація для ШІ" (KeyCRM CT_1011) — нотатки для бота, окремо від presentationText (текст для клієнта)
  sizeChartData       Json? // структурована розмірна сітка (KeyCRM CT_1012: {title,unit,sizes[],measurements}) — доповнює sizeChartImage (той самий чарт, але як картинка)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  offers          Offer[]
  setOf           ProductSetComponent[] @relation("SetParent")
  usedInSets      ProductSetComponent[] @relation("SetComponent")
  orderItems      OrderItem[]
  ads             Ad[]
  productExpense  ProductExpense?

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
}

// §4.2 setComponents[] — {productId, qty}[], реляційно замість рядка-токена
model ProductSetComponent {
  id                String  @id @default(uuid())
  parentProductId   String
  parentProduct     Product @relation("SetParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct  Product @relation("SetComponent", fields: [componentProductId], references: [id])
  qty               Int     @default(1)

  @@unique([parentProductId, componentProductId])
}

// ─────────────────────────────────────────────────────────────
// §4.3 Offer — варіант товару (колір/розмір)
// ─────────────────────────────────────────────────────────────
model Offer {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  price      Decimal? @db.Decimal(12, 2)
  properties Json     @default("[]") // [{name,value}] — розмір/колір тощо
  images     String[] @default([]) // до 10 фото, перше = головне
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// §4.6 Buyer
// ─────────────────────────────────────────────────────────────
model Buyer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName    String?
  phone       String // дедуп-ключ
  igUsername  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.7 Pipeline / Stage
// ─────────────────────────────────────────────────────────────
model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  stages Stage[]

  @@index([tenantId])
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)

  orders Order[]

  @@index([pipelineId])
}

// ─────────────────────────────────────────────────────────────
// §4.8 Order
// ─────────────────────────────────────────────────────────────
model Order {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerId        String?
  buyer          Buyer?    @relation(fields: [buyerId], references: [id])
  stageId        String?
  stage          Stage?    @relation(fields: [stageId], references: [id])
  sourceName     String?
  managerComment String?
  shipping       Json? // {city, warehouse, ...}
  ttn            String[]  @default([]) // може бути кілька номерів ТТН
  ttnStatus      String?
  firstTouchAdId String?
  firstTouchAd   Ad?       @relation("FirstTouch", fields: [firstTouchAdId], references: [id])
  firstTouchAt   DateTime?
  lastTouchAdId  String?
  lastTouchAd    Ad?       @relation("LastTouch", fields: [lastTouchAdId], references: [id])
  lastTouchAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items    OrderItem[]
  returns  Return[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, createdAt])
}

// §4.8 items[] — реляційно (не JSON), бо аналітика §6 рахує по позиціях
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id])
  name      String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(1)
  properties Json?   // {name,value}[] на момент продажу (сніпшот)
  isUpsell  Boolean  @default(false)

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// §4.9 Ad / AdSpendDaily / AdClick
// ─────────────────────────────────────────────────────────────
model Ad {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId String? // id оголошення в рекламному кабінеті
  name       String?
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  spendDaily      AdSpendDaily[]
  clicks          AdClick[]
  ordersFirstTouch Order[] @relation("FirstTouch")
  ordersLastTouch  Order[] @relation("LastTouch")

  @@index([tenantId])
  @@index([tenantId, productId])
}

model AdSpendDaily {
  id       String   @id @default(uuid())
  adId     String
  ad       Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("UAH")

  @@unique([adId, date])
  @@index([adId, date])
}

model AdClick {
  id        String   @id @default(uuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  sessionId String?
  timestamp DateTime @default(now())

  @@index([adId, timestamp])
}

// ─────────────────────────────────────────────────────────────
// §4.10 ProductExpense
// ─────────────────────────────────────────────────────────────
model ProductExpense {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cogs               Decimal  @default(0) @db.Decimal(12, 2)
  managerCostFixed   Decimal  @default(0) @db.Decimal(12, 2)
  managerCostPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Payment — ДОПОВНЕННЯ до ТЗ: §9.14 «Журнал платежів» посилається на платежі,
// пов'язані з Order, але §4 їх не визначає (прогалина в ТЗ). Модель мінімальна:
// лише відображення журналу (звірка йде на боці воронки, Monobank/ibanoplata —
// див. covercar-payments), воронка пише сюди факт оплати через POST /payments
// (той самий Bearer tenant.apiKey, аналогічно ttn-status/ad-spend-daily).
// ─────────────────────────────────────────────────────────────
model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String? // monobank / ibanoplata / готівка / інше
  status    String? // success / pending / failed — як передає воронка
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// §4.11 Return
// ─────────────────────────────────────────────────────────────
enum ReturnType {
  return
  exchange
}

enum ReturnStatus {
  new
  confirmed
  completed
}

model Return {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      ReturnType
  reason    String?
  status    ReturnStatus @default(new)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@index([orderId])
}
