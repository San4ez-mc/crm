// Fineko CRM — модель даних. Джерело істини: ТЗ §4 (D:\...\СРМ\ТЗ-власна-СРМ.md).
// Мультитенантність з дня 1: усі бізнес-сутності мають tenantId + індекс.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// §4.1 Tenant — окремий магазин-клієнт СРМ
// ─────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique @default(uuid()) // Bearer для воронки/MCP/Flows-автоматизацій цього tenant
  ssoOrgId  String? // звʼязок з обліковим записом у SSO-панелі FINEKO
  novaPoshtaApiKey String? // §9.17 — ключ для крон-Flows, що опитує статуси ТТН
  // ДОПОВНЕННЯ 2026-08-31 — ручні фінансові параметри для щоденного аналітичного зведення
  // (скріншот "Рука на пульсі"). Формула розподілу відмов/собівартості ще не узгоджена
  // з Олексієм — тут лише сирі вхідні дані, без прихованої логіки розрахунку.
  usdExchangeRate     Decimal? @db.Decimal(10, 4) // "Курс доллара, грн" — оновлюється вручну
  dailyFixedCosts     Decimal? @db.Decimal(12, 2) // "Постійні витрати, $" за добу
  dailyPayrollCosts   Decimal? @db.Decimal(12, 2) // "Витрати на оплату праці, $" за добу
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       Category[]
  suppliers        Supplier[]
  products         Product[]
  buyers           Buyer[]
  pipelines        Pipeline[]
  orders           Order[]
  ads              Ad[]
  productExpenses  ProductExpense[]
  returns          Return[]
  payments         Payment[]
  fops             Fop[]
  secrets          TenantSecret[]
  funnelEvents     FunnelEvent[]
  knowledgeEntries KnowledgeEntry[]
  knowledgeProfile KnowledgeProfile?
}

// ─────────────────────────────────────────────────────────────
// ДОПОВНЕННЯ 2026-09-01 — Етапи воронки (аналітика конверсії).
// Джерело подій — окрема нода "Етап воронки" у FINEKO Flows (не хардкод, довільна
// назва/порядок на розсуд автора воронки, тому й немає фіксованого enum stageName).
// Дедуп по (tenantId, sessionId, stageName) — повторний прохід через ту саму ноду
// в тій самій розмові не роздуває лічильник, лише оновлює occurredAt.
// ─────────────────────────────────────────────────────────────
model FunnelEvent {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funnelSlug String? // slug бота Flows — щоб на дашборді розрізняти воронки одного tenant
  sessionId  String // session.id з Flows — унікальний ідентифікатор розмови
  stageName  String
  stageOrder Int      @default(0) // порядок на графіку-воронці, задає автор ноди
  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, sessionId, stageName])
  @@index([tenantId, funnelSlug])
  @@index([tenantId, stageName])
}

// ─────────────────────────────────────────────────────────────
// §4.5 Category
// ─────────────────────────────────────────────────────────────
model Category {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  aiInstructions String? // що бот має дізнатись у клієнта для товарів цієї категорії (вільний текст)
  // ДОПОВНЕННЯ 2026-09-01 — структурований список параметрів для збору перед оформленням
  // (зріст/вага для одягу, розмір стопи для взуття тощо) — [{name,unit,hint}], щоб воронка
  // питала програмно, а не парсила вільний aiInstructions.
  requiredParams Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
  knowledgeEntries KnowledgeEntry[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.4 Supplier
// ─────────────────────────────────────────────────────────────
model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  mechanism   String? // ручне / EasyDrop / BrewDrop / інше
  contactInfo String?
  description String? // ДОПОВНЕННЯ 2026-08-31: опис постачальника
  aiNotes     String? // нотатки для ШІ (нюанси роботи з цим постачальником — не для клієнта)
  website     String? // ДОПОВНЕННЯ 2026-08-31: сайт постачальника
  telegramGroupId String? // id телеграм-групи з постачальником
  loginUsername   String? // логін до сайту постачальника
  loginPassword   String? // пароль до сайту постачальника — зберігається як є, без маскування (внутрішній інструмент)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// ДОПОВНЕННЯ 2026-08-31 — ФОП (юрособа для прийому оплат), окрема сутність per-tenant
// (не спільна між магазинами — власник підтвердив: "раз все ділиться по магазинах,
// то нехай все так і ділиться"). Використовується covercar-воронкою для звірки квитанцій
// (див. [[covercar-payments-wip]] пам'ять) — тут стає єдиним місцем зберігання цих даних.
// ─────────────────────────────────────────────────────────────
model Fop {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String // назва/ПІБ ФОП
  iban          String?
  taxId         String? // ІПН
  monobankToken String? // токен Monobank Open API для звірки надходжень
  isActive      Boolean  @default(false) // "активний" ФОП магазину — лише один true на tenant (див. §API PATCH /fops/:id/activate)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// ДОПОВНЕННЯ 2026-08-31 — Секрети/ключі per-tenant (Meta/FB, інші API), щоб клієнт
// заповнював усе в одному місці (СРМ), а не в кожній воронці окремо. `syncedToFunnelAt`
// фіксує, коли значення востаннє віддавалось у Flows через export-ендпойнт (§ проєктні нотатки) —
// сам перенос у funnelKey виконує окремий js-node воронки, що тягне GET /api/tenants/:id/secrets/export.
// ─────────────────────────────────────────────────────────────
model TenantSecret {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key              String // напр. META_SYSTEM_USER_TOKEN, META_AD_ACCOUNT_ID, FB_PIXEL_ID, FB_CAPI_TOKEN
  label            String? // людська назва для UI, якщо key недостатньо промовистий
  value            String
  isSecret         Boolean   @default(true) // чи маскувати значення в адмінці/у read-МСР
  syncedToFunnelAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.2 Product
// ─────────────────────────────────────────────────────────────
model Product {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String // внутрішня назва (від постачальника/для CRM)
  customerName        String? // ДОПОВНЕННЯ 2026-09-01 — назва, яку бачить клієнт у боті; порожньо → показуємо `name`
  sku                 String
  price               Decimal  @db.Decimal(12, 2)
  minPrice            Decimal? @db.Decimal(12, 2)
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  presentationText    String? // "Презентація для клієнта" — готовий текст, бот показує verbatim
  adMatchTokens       String[] @default([]) // токени для матчингу за рекламою/артикулом
  companionProductIds String[] @default([]) // допродажі — багато-вибір товарів
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  supplierArticle     String?
  sizeChartImage      String? // шлях/URL до завантаженого файлу
  // ДОПОВНЕННЯ до §4.2 — виявлено при міграції з KeyCRM, у ТЗ не описані, але дані реальні:
  thumbnailUrl        String? // мініатюра для списку товарів (§9.2 "фото (мініатюра thumbnailUrl)" — поле згадане в UI-специфікації, але не було в моделі)
  images              String[] @default([]) // загальні фото товару (KeyCRM attachments_data), не привʼязані до конкретного offer-кольору
  aiNotes             String? // "Додаткова інформація для ШІ" (KeyCRM CT_1011) — нотатки для бота, окремо від presentationText (текст для клієнта)
  sizeChartData       Json? // структурована розмірна сітка (KeyCRM CT_1012: {title,unit,sizes[],measurements}) — доповнює sizeChartImage (той самий чарт, але як картинка)
  // ДОПОВНЕННЯ 2026-08-31 (фідбек власника): ціна за кількість — та сама для ВСІХ
  // варіантів кольору товару (KeyCRM CT_1007 "Ціна за 2 шт" тощо). [{quantity,price}].
  bulkPricing         Json     @default("[]")
  // ДОПОВНЕННЯ 2026-08-31 (фідбек власника): "Комплекти" — окрема сутність у меню,
  // не категорія. Технічно лишається Product (переваги/фото/ціна/варіанти ті самі),
  // прапорець лише перемикає, в якому пункті меню й списку він з'являється.
  isSet               Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  offers          Offer[]
  setOf           ProductSetComponent[] @relation("SetParent")
  usedInSets      ProductSetComponent[] @relation("SetComponent")
  orderItems      OrderItem[]
  ads             Ad[]
  productExpense  ProductExpense?
  knowledgeEntries KnowledgeEntry[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
}

// §4.2 setComponents[] — {productId, qty}[], реляційно замість рядка-токена
model ProductSetComponent {
  id                String  @id @default(uuid())
  parentProductId   String
  parentProduct     Product @relation("SetParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct  Product @relation("SetComponent", fields: [componentProductId], references: [id])
  qty               Int     @default(1)

  @@unique([parentProductId, componentProductId])
}

// ─────────────────────────────────────────────────────────────
// §4.3 Offer — варіант товару (колір/розмір)
// ─────────────────────────────────────────────────────────────
model Offer {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  price      Decimal? @db.Decimal(12, 2) // лишається в схемі (дані з KeyCRM-міграції), але UI більше не дає редагувати per-offer — ціна єдина на товар (Product.price/bulkPricing)
  quantity   Int? // ДОПОВНЕННЯ 2026-08-31: своя кількість на кожен варіант кольору (фідбек власника)
  properties Json     @default("[]") // [{name,value}] — розмір/колір тощо
  images     String[] @default([]) // до 10 фото, перше = головне
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// §4.6 Buyer
// ─────────────────────────────────────────────────────────────
model Buyer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName    String?
  phone       String // дедуп-ключ
  igUsername  String?
  // Пам'ять вимірів клієнта — гнучкий об'єкт {[paramName]: value}, напр. {"зріст":"175","вага":"65"}.
  // Ключі — ТІ САМІ назви параметрів, що в Category.requiredParams (жодного хардкоду категорій),
  // щоб воронка могла звірити "чи всі потрібні параметри поточного товару вже відомі" прямим
  // порівнянням імен. Заповнюється PATCH /buyers/:id, читається воронкою на кроці підбору розміру.
  knownMeasurements Json?
  // Пам'ять реквізитів доставки клієнта — {fullName, phone, city, warehouse}, той самий принцип,
  // що knownMeasurements (2026-09-04): щоб воронка на кроці збору доставки (n_collect) могла
  // запропонувати вже відомі дані повторному клієнту замість повторного запитування. fullName/
  // phone тут МОЖУТЬ відрізнятись від Buyer.fullName/phone — отримувач посилки не завжди сам
  // покупець (напр. замовляють подарунок). Заповнюється автоматично з Order.shipping при
  // POST /orders (якщо вказано), або вручну через PATCH /buyers/:id (картка покупця в СРМ).
  knownShipping Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// §4.7 Pipeline / Stage
// ─────────────────────────────────────────────────────────────
model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  stages Stage[]

  @@index([tenantId])
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)

  orders Order[]

  @@index([pipelineId])
}

// ─────────────────────────────────────────────────────────────
// §4.8 Order
// ─────────────────────────────────────────────────────────────
model Order {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerId        String?
  buyer          Buyer?    @relation(fields: [buyerId], references: [id])
  stageId        String?
  stage          Stage?    @relation(fields: [stageId], references: [id])
  sourceName     String?
  managerComment String?
  shipping       Json? // {city, warehouse, ...}
  ttn            String[]  @default([]) // може бути кілька номерів ТТН
  ttnStatus      String?
  isRefused      Boolean   @default(false) // "Відмова" — клієнт не забрав/не оплатив на НП (§ дод. 2026-08-31).
  // Фінансові наслідки відмови (хто платить за зворотну доставку тощо) ще не узгоджені —
  // тут лише факт відмови для підрахунку %, без прихованої логіки розподілу витрат.
  firstTouchAdId String?
  firstTouchAd   Ad?       @relation("FirstTouch", fields: [firstTouchAdId], references: [id])
  firstTouchAt   DateTime?
  lastTouchAdId  String?
  lastTouchAd    Ad?       @relation("LastTouch", fields: [lastTouchAdId], references: [id])
  lastTouchAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items    OrderItem[]
  returns  Return[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, createdAt])
}

// §4.8 items[] — реляційно (не JSON), бо аналітика §6 рахує по позиціях
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id])
  name      String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(1)
  properties Json?   // {name,value}[] на момент продажу (сніпшот)
  isUpsell  Boolean  @default(false)

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// §4.9 Ad / AdSpendDaily / AdClick
// ─────────────────────────────────────────────────────────────
model Ad {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId String? // id оголошення в рекламному кабінеті
  name       String?
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  // Метадані з Meta Marketing API (заповнює крон-Flows, § Meta Ads інтеграція 2026-08-31).
  campaignId   String? // id кампанії в Meta
  campaignName String?
  adAccountId  String? // id рекламного кабінету, з якого прийшли дані
  thumbnailUrl String? // мініатюра креативу (Meta Graph creative.thumbnail_url) — заповнює той самий крон
  createdAt  DateTime @default(now())

  spendDaily      AdSpendDaily[]
  clicks          AdClick[]
  ordersFirstTouch Order[] @relation("FirstTouch")
  ordersLastTouch  Order[] @relation("LastTouch")

  @@index([tenantId])
  @@index([tenantId, productId])
}

model AdSpendDaily {
  id       String   @id @default(uuid())
  adId     String
  ad       Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("UAH")
  // Платформні метрики Meta (не наш AdClick — те, що сам Facebook рахує показами/кліками
  // по оголошенню) — потрібні для CPC/CTR/CPM у щоденному зведенні.
  impressions Int?
  clicks      Int?

  @@unique([adId, date])
  @@index([adId, date])
}

model AdClick {
  id        String   @id @default(uuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  sessionId String?
  timestamp DateTime @default(now())

  @@index([adId, timestamp])
}

// ─────────────────────────────────────────────────────────────
// §4.10 ProductExpense
// ─────────────────────────────────────────────────────────────
model ProductExpense {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cogs               Decimal  @default(0) @db.Decimal(12, 2)
  managerCostFixed   Decimal  @default(0) @db.Decimal(12, 2)
  managerCostPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Payment — ДОПОВНЕННЯ до ТЗ: §9.14 «Журнал платежів» посилається на платежі,
// пов'язані з Order, але §4 їх не визначає (прогалина в ТЗ). Модель мінімальна:
// лише відображення журналу (звірка йде на боці воронки, Monobank/ibanoplata —
// див. covercar-payments), воронка пише сюди факт оплати через POST /payments
// (той самий Bearer tenant.apiKey, аналогічно ttn-status/ad-spend-daily).
// ─────────────────────────────────────────────────────────────
model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String? // monobank / ibanoplata / готівка / інше
  status    String? // success / pending / failed — як передає воронка
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// §4.11 Return
// ─────────────────────────────────────────────────────────────
enum ReturnType {
  return
  exchange
}

enum ReturnStatus {
  new
  confirmed
  completed
}

model Return {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      ReturnType
  reason    String?
  status    ReturnStatus @default(new)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// База знань магазину (ТЗ-база-знань-магазину.md, 2026-09-04) — одне місце в CRM, де
// менеджер веде FAQ/політики/заперечення/скрипти, а воронки беруть їх автоматично замість
// funnelKey SHOP_FAQ (дублювався в кожному боті) і векторної бази (шукала на кожне
// повідомлення, без історії хто що редагував). Перенесення самих воронок на ці ендпойнти —
// окрема робота (§3, §6 ТЗ), тут лише сторона CRM: модель+API+UI.
model KnowledgeEntry {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       String // faq | policy | objection | script
  question   String? // як клієнт питає; кілька варіантів через "|"; порожньо для policy/script
  answer     String
  tags       String[] @default([])
  scope      String   @default("shop") // shop | category | product
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  priority   Int      @default(0) // вище = раніше в промпті
  isActive   Boolean  @default(true)
  source     String   @default("manual") // manual | imported_gdoc | from_dialog
  createdBy  String?
  sessionId  String? // для from_dialog — посилання на сесію-джерело у Flows
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, isActive])
}

// Короткі "завжди в промпті" факти — те, що зараз розкидано по funnelKey SHOP_FAQ/
// ORDER_TERMS_LINE кожного бота; один запис на tenant.
model KnowledgeProfile {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producerLine String?
  shippingLine String?
  fittingLine  String?
  paymentLine  String?
  termsLine    String?
  updatedAt    DateTime @updatedAt
}
