# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fineko_crm"

# ==================== API SERVER ====================
PORT=4700
NODE_ENV=development

# ==================== MCP ====================
# Bearer-секрет для /api/mcp, /api/mcp-edit. Якщо порожньо — авторизація відкрита (тільки для локальної розробки).
MCP_SECRET=

# ==================== SSO (crm.fineko.space) ====================
SSO_URL=http://localhost:4600
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# Секрет, яким SSO звертається до GET /api/auth/sso/projects і /pages (x-sso-secret) — той самий, що SSO_CLIENT_SECRET.

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== FLOWS (кнопка "Отримати дані зараз") ====================
# Системний секрет FINEKO Flows (X-Api-Secret, той самий, що FINEKO Flows API_SECRET) —
# дозволяє CRM запустити тест-сесію cron-воронки (напр. Meta Ads Sync) вручну.
# botId per-tenant зберігається як TenantSecret FLOWS_META_SYNC_BOT_ID, не тут.
FLOWS_API_URL=http://localhost:3000
FLOWS_API_SECRET=

# ==================== ОПЛАТА ПІДПИСКИ (WayForPay) ====================
# Без цих ключів кнопка «Оплатити» показує, що онлайн-оплата не підключена. Значення беруться в кабінеті WayForPay (Магазини → ваш магазин → Налаштування).
WFP_MERCHANT_ACCOUNT=
WFP_SECRET_KEY=
WFP_MERCHANT_DOMAIN=pcrm.fineko.space
# UAH (за замовчуванням; ціна в $ переводиться за курсом) або USD
WFP_CURRENCY=UAH
# Публічна адреса CRM (для returnUrl/serviceUrl WayForPay). За замовчуванням — ADMIN_BASE_URL.
CRM_PUBLIC_URL=https://pcrm.fineko.space
