{
  "name": "fineko-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22"
  },
  "scripts": {
    "dev:api": "yarn workspace @crm/api dev",
    "dev:mcp": "yarn workspace @crm/mcp dev",
    "dev:admin": "yarn workspace @crm/admin dev",
    "build:admin": "yarn workspace @crm/admin build",
    "db:generate": "yarn workspace @crm/db generate",
    "db:migrate:dev": "yarn workspace @crm/db migrate:dev",
    "db:migrate:deploy": "yarn workspace @crm/db migrate:deploy",
    "db:studio": "yarn workspace @crm/db studio",
    "db:seed": "yarn workspace @crm/db seed"
  }
}
